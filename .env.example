# Dedicated local database (create it with scripts/create-database.ts first)
DATABASE_URL=postgresql://localhost:5432/thinktrain

# Slack Socket Mode credentials. Never commit real values.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_SIGNING_SECRET=replace-with-signing-secret
SLACK_USER_ID=U0123456789
SLACK_CHANNEL_ID=D0123456789
DASHBOARD_URL=http://127.0.0.1:43127

# Antigravity CLI uses the Google account authenticated on this Mac.
ANTIGRAVITY_EXECUTABLE=agy

# Local AI fallback settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3
# Only use deterministic demo scoring during setup. Never mistake it for real evaluation.
ALLOW_MOCK_AI=false
AI_TIMEOUT_MS=45000
LOG_LEVEL=info
