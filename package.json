{
  "name": "thinktrain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43127",
    "dev:worker": "tsx --env-file=.env.local scripts/start-backend.ts",
    "dev:all": "concurrently --kill-others-on-fail \"npm run dev\" \"npm run dev:worker\"",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43127",
    "worker": "tsx --env-file=.env.local scripts/start-backend.ts",
    "local": "concurrently --kill-others-on-fail \"npm run start\" \"npm run worker\"",
    "db:create": "tsx --env-file=.env.local scripts/create-database.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:reset-progress": "tsx --env-file=.env.local scripts/reset-progress.ts --confirm",
    "slack:setup-secrets": "bash scripts/setup-slack-secrets.sh",
    "slack:setup-dm": "tsx --env-file=.env.local scripts/setup-slack-dm.ts",
    "slack:setup": "npm run slack:setup-secrets && npm run slack:setup-dm",
    "slack:test": "tsx --env-file=.env.local scripts/start-backend.ts --send-now",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@slack/bolt": "^5.0.0",
    "@slack/types": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-holidays": "^3.36.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "Slack-first logical thinking practice"
}
